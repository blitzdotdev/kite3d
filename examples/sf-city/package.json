{
  "name": "sf-city",
  "private": true,
  "type": "module",
  "mainScene": "assets/main.scene.gltf",
  "main": "./main.js",
  "scripts": {
    "dev": "kite3d dev",
    "city:fetch": "python3 scene/fetch.py",
    "city:build": "node assets/models/city/build.mjs && node scene/compose.mjs"
  },
  "kite3d": {
    "viewer": {
      "backgroundColor": "#c6d3db",
      "renderScale": 1,
      "maxRenderScale": 1,
      "msaa": true,
      "camera": {"position": [350, 300, 440], "target": [0, 15, 0]}
    }
  },
  "devDependencies": {
    "kite3d": "0.21.0-alpha.8",
    "three": "https://github.com/repalash/three.js-modded/releases/download/v0.163.10003/package.tgz"
  }
}
